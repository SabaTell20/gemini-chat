# .env.example - copy this file to .env and fill in your own values.
# .env holds secrets, so it is in .gitignore and is never uploaded to GitHub.

# The site opens at http://localhost:8080 (change the port here if it is taken)
APP_PORT=8080
# Your timezone, so "today" in the chat list and in Billing matches your clock (e.g. Europe/Berlin)
TZ=UTC

# Gemini
API_KEY=
MODEL=gemini-4-argon

# MySQL (runs inside Docker; pick any long random passwords)
DB_NAME=chatbot_db
DB_USER=chatbot
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis (runs inside Docker; pick any long random password, letters and digits only)
REDIS_PASSWORD=

# The first admin, created automatically when the database is still empty
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend SMTP (https://resend.com/docs/send-with-smtp)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
# your Resend API key, it starts with re_
SMTP_PASSWORD=
# While testing, Resend only lets you send from this address,
# and only TO the email you signed up to Resend with.
MAIL_FROM="Gemini Chatbot <onboarding@resend.dev>"

# ElevenLabs voice agent (public agent, so no API key needed)
ELEVENLABS_AGENT_ID=
